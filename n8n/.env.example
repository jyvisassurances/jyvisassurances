# Copier ce fichier en .env puis remplir les valeurs : cp .env.example .env

# Domaine public de n8n (un enregistrement DNS A doit pointer vers le serveur)
N8N_HOST=n8n.jyvis-assurances.fr

# Version de n8n (laisser "latest" ou fixer une version, ex. 1.120.0)
N8N_VERSION=latest

TIMEZONE=Europe/Paris

# Base de données
POSTGRES_USER=n8n
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=n8n

# Clé de chiffrement des identifiants n8n — générer avec : openssl rand -hex 32
# À sauvegarder : sans elle, les identifiants enregistrés deviennent illisibles.
N8N_ENCRYPTION_KEY=changez-moi

# ------------------------------------------------------------------ Agent WhatsApp
# Meta for Developers > votre application > WhatsApp > Configuration de l'API
WHATSAPP_PHONE_NUMBER_ID=
# Jeton d'accès permanent d'un « utilisateur système » (Business Manager > Utilisateurs système)
WHATSAPP_ACCESS_TOKEN=
# Paramètres de l'application > Général > Clé secrète
WHATSAPP_APP_SECRET=
# Mot de passe de votre choix, à recopier dans Meta (« Jeton de vérification ») — openssl rand -hex 16
WHATSAPP_VERIFY_TOKEN=
GRAPH_API_VERSION=v23.0

# Clé API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Informations reprises par l'agent
CABINET_ORIAS=
CABINET_HORAIRES=du lundi au vendredi, 9 h - 18 h

# Alertes e-mail au conseiller (prospect chaud ou demande d'un humain)
CONSEILLER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Accès au tableau de bord https://<N8N_HOST>/webhook/jyvis
TABLEAU_UTILISATEUR=jyvis
TABLEAU_MOT_DE_PASSE=changez-moi
